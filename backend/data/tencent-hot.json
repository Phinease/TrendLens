_all_rel":0,"close_share_pull":0,"close_relate_thing":0,"close_all_emoticon_comment":0,"political_option":"0","pc_not_display":""},"category":{"cate1_name":"社会","cate1_en_name":"society","cate1_id":"20242855","cate2_name":"社会百态","cate2_id":"20461010"},"declare":{},"pub_info":{"source":"2","sub_source":"0"},"payment_info":{},"user_address":"四川","dislike_options":[{"menu_id":"0","menu_name":"不感兴趣","menu_items":[{"type":"dislike_cp","name":"不推荐该作者","id":"40033"},{"type":"dislike_content","name":"减少此类内容","id":"40022"}]}],"cp_info":{"tnews_self_made":-1},"extra_property":{},"share_info":{"share_title":"上门喂宠成春节限定副业，有人日入上千，还有品牌开卖宠物年夜饭","share_subtitle":"红星资本局2月19日消息，春节期间，上门喂宠成为部分年轻人的“限定”副业，在小红书、抖音等多个平台，部分网友发帖称“承包”了自己周边的“上门喂宠”业务。对于没有返乡需求的部分年轻人来说，春节期间代喂养宠物或可为他们带来每日上千元的收益。资料配图 图据图虫创意“一般春节前后是高峰期，很多人是在年三十前后才..."},"long_summary":"春节期间，上门喂宠成为部分年轻人的“限定”副业，在小红书、抖音等多个平台，部分网友发帖称“承包”了自己周边的“上门喂宠”业务。2月18日，来自深圳的小李告诉红星资本局，今年是他做“上门喂宠”的第四年，每天收入在1000元左右。据了解，“上门喂宠”的收费标准并不固定。红星资本局了解到，在春节期间，也有部分小众宠物食品品牌推出了“宠物年夜饭”，售卖宠物可食用的汤圆、饺子、惠灵顿牛排等食品，满足宠物主人想与宠物“一起过年”的心情。"},{"id":"20260219A05HJ700","articletype":"0","title":"股价一年暴涨2倍！迈为股份两名实控人半月内“精准”套现17亿元离场","pic_style":0,"publish_time":"2026-02-19 19:29:09","pic_info":{"big_img":["https://inews.gtimg.com/news_ls/O5Zg8C-QZKViqWLIy_9g5GfodFMT_dsuitUwMaf-XgnxgAA_870492/0"],"small_img":["https://inews.gtimg.com/news_ls/O5Zg8C-QZKViqWLIy_9g5GfodFMT_dsuitUwMaf-XgnxgAA_294195/0"],"three_img":["https://inews.gtimg.com/news_ls/O5Zg8C-QZKViqWLIy_9g5GfodFMT_dsuitUwMaf-XgnxgAA_197130/0"],"ls_img_exp_type":"1","ext":{"196x130":"https://inews.gtimg.com/news_ls/O5Zg8C-QZKViqWLIy_9g5GfodFMT_dsuitUwMaf-XgnxgAA_196130/0","360x240":"https://inews.gtimg.com/news_ls/O5Zg8C-QZKViqWLIy_9g5GfodFMT_dsuitUwMaf-XgnxgAA_360240/0","330x330":"https://inews.gtimg.com/news_ls/OOQO4p0LobHTBErutyHcxjrSGFXYQijIy7dEqeaSpDt_4AA_330330/0"},"share_img":"https://inews.gtimg.com/news_bt/O3MvSrni4aEJFkd5R9z_Cfs6Qrua6BpdEtSlKT1s3flmAAA/0","img_count":1},"link_info":{"share_url":"https://view.inews.qq