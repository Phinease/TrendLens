                            <script>
                                var old_key = document.querySelector(".old_key");
                                old_key.onclick = function() {
                                    const d = new Date();
                                    d.setTime(d.getTime() + (30 * 24 * 60 * 60 * 1000));
                                    const expires = "expires=" + d.toUTCString();

                                    // 获取原始域名
                                    var homeDomain = "https://www.oschina.net";

                                    // 处理域名前缀
                                    if (homeDomain.endsWith('.net')) {
                                        // 如果是.net结尾，去除https://www前缀
                                        homeDomain = homeDomain.replace(/^https:\/\/www\./, '');
                                    } else if (homeDomain.endsWith('.osc')) {
                                        // 如果是.osc结尾，去除http://www前缀
                                        homeDomain = homeDomain.replace(/^http:\/\/www\./, '');
                                    }

                                    document.cookie = "old_key=false;" + expires + ";path=/;domain=" + homeDomain;
                                    // 刷新页面
                                    window.location.reload();
                                };
                            </script>
